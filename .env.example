# Copy to .env.local for local development (never commit .env.local).
#
# The project request form posts to /api/contact, which is NOT built yet (preflight 006 stops before it).
# Until it is, the form shows its error state with the phone number. When the route is built it will need:
#
# Resend API key (resend.com → API Keys). Server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
#
# Inbox that receives project requests (open question for Omar; see content/pending.ts).
CONTACT_TO_EMAIL=
#
# Sender address. Previews: Resend's test sender "Sampayo Website <onboarding@resend.dev>", which only
# delivers to the Resend account owner's inbox. Production: an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=
#
# Vercel sets these automatically at build time; you don't set them:
#   VERCEL_ENV          "production" | "preview" | "development". The production gates
#                       (npm run gates) block a production build that still has placeholders.
#   VERCEL_URL / VERCEL_BRANCH_URL   Preview host, used for canonical URLs on previews.
